{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terminalvalue.net/software-factory/schema/v1.json",
  "title": "Software Factory public data, version 1",
  "description": "Frozen in Phase 0 (docs/software-factory.md). Every record a build or refresh publishes validates against one of these $defs, by name, with blog/software-factory/validate.mjs. A change to this file is a contract change: it goes through the merge loop, never one stream alone.",
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "snapshotId": { "type": "string", "pattern": "^sf1-[0-9a-f]{16}$" },
    "instant": { "type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(\\.\\d+)?(Z|[+-]\\d\\d:\\d\\d)$" },
    "localDate": { "type": "string", "pattern": "^\\d{4}-\\d\\d-\\d\\d$" },
    "metricId": {
      "enum": [
        "usage_usd",
        "model_calls",
        "cache_reuse",
        "verification_completed",
        "verification_duration_median",
        "changes_recorded",
        "examples_catalog",
        "usage_share_by_model"
      ]
    },
    "coverage": {
      "type": "object",
      "description": "How much of the population a value is computed over. included <= total; missing counts the records left out because a needed value was absent.",
      "required": ["included", "total"],
      "additionalProperties": false,
      "properties": {
        "included": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 },
        "note": { "type": ["string", "null"] }
      }
    },
    "table": {
      "type": "object",
      "description": "Rows of numbers, one array per row, in the order of columns. Columns named like an axis (day, model, effort, status) hold an index into that axis of the overview.",
      "required": ["columns", "rows"],
      "additionalProperties": false,
      "properties": {
        "columns": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "rows": { "type": "array", "items": { "type": "array", "items": { "type": ["number", "null"] } } }
      }
    },

    "pointer": {
      "type": "object",
      "description": "latest.json: which snapshot is current, and when the source was last checked. Transport metadata: it changes on every check; a snapshot never does.",
      "required": ["schema", "snapshotId", "manifest", "publishedAt", "lastSourceCheck"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "software-factory-pointer/v1" },
        "snapshotId": { "$ref": "#/$defs/snapshotId" },
        "manifest": { "type": "string", "pattern": "^snapshots/sf1-[0-9a-f]{16}/manifest\\.json$" },
        "publishedAt": { "$ref": "#/$defs/instant" },
        "lastSourceCheck": {
          "type": "object",
          "required": ["at", "sha", "outcome"],
          "additionalProperties": false,
          "properties": {
            "at": { "$ref": "#/$defs/instant" },
            "sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
            "outcome": { "enum": ["new-snapshot", "unchanged", "failed"] },
            "error": { "type": ["string", "null"] }
          }
        }
      }
    },

    "manifest": {
      "type": "object",
      "description": "snapshots/<id>/manifest.json: what a snapshot was made from and what it holds. Deterministic: no clock in it but the source's own times.",
      "required": ["schema", "snapshotId", "source", "generator", "configSha256", "metricDefinitions", "pricingAsOf", "timezone", "collections", "datasets"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "software-factory-snapshot/v1" },
        "snapshotId": { "$ref": "#/$defs/snapshotId" },
        "source": {
          "type": "object",
          "required": ["repository", "sha", "inputs"],
          "additionalProperties": false,
          "properties": {
            "repository": { "const": "pilifs/in-the-loop" },
            "sha": { "$ref": "#/$defs/sha" },
            "inputs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["path", "sha256", "bytes", "schema"],
                "additionalProperties": false,
                "properties": {
                  "path": { "type": "string" },
                  "sha256": { "$ref": "#/$defs/sha256" },
                  "bytes": { "type": "integer", "minimum": 0 },
                  "schema": { "type": "string" }
                }
              }
            }
          }
        },
        "generator": {
          "type": "object",
          "required": ["name", "version"],
          "additionalProperties": false,
          "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
        },
        "configSha256": { "$ref": "#/$defs/sha256" },
        "metricDefinitions": {
          "type": "object",
          "required": ["version", "sha256"],
          "additionalProperties": false,
          "properties": { "version": { "type": "string" }, "sha256": { "$ref": "#/$defs/sha256" } }
        },
        "pricingAsOf": { "type": ["string", "null"] },
        "timezone": { "const": "America/Toronto" },
        "collections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "path", "sha256", "bytes", "records"],
            "additionalProperties": false,
            "properties": {
              "name": { "enum": ["overview", "sessions", "changes", "verification", "examples"] },
              "path": { "type": "string", "pattern": "^(overview|details/(sessions|changes|verification|examples))\\.json$" },
              "sha256": { "$ref": "#/$defs/sha256" },
              "bytes": { "type": "integer", "minimum": 0 },
              "records": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "datasets": {
          "type": "array",
          "description": "Measurement bounds and completeness per dataset. A period dataset covers [from, to) in UTC; a stock is a count at the source revision, with no period.",
          "items": {
            "type": "object",
            "required": ["id", "kind", "from", "to", "coverage"],
            "additionalProperties": false,
            "properties": {
              "id": { "enum": ["usage", "verification", "changes", "catalog"] },
              "kind": { "enum": ["period", "stock"] },
              "from": { "type": ["string", "null"] },
              "to": { "type": ["string", "null"] },
              "coverage": { "$ref": "#/$defs/coverage" }
            }
          }
        }
      }
    },

    "overview": {
      "type": "object",
      "description": "overview.json: everything the first screen needs, compact. Period measures are recomputed in the browser from usage and verification for a chosen range; measures holds their all-time values, so the static page has them without script.",
      "required": ["schema", "snapshotId", "timezone", "pricingAsOf", "days", "models", "efforts", "usage", "verification", "measures", "stocks", "breakdowns", "insights"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "software-factory-overview/v1" },
        "snapshotId": { "$ref": "#/$defs/snapshotId" },
        "timezone": { "const": "America/Toronto" },
        "pricingAsOf": { "type": ["string", "null"] },
        "days": {
          "type": "array",
          "description": "Every calendar day in the timezone from the first to the last day with activity, with no gaps.",
          "items": { "$ref": "#/$defs/localDate" }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "additionalProperties": false,
            "properties": { "id": { "type": "string" }, "label": { "type": "string" } }
          }
        },
        "efforts": { "type": "array", "items": { "type": ["string", "null"] } },
        "usage": {
          "$ref": "#/$defs/table",
          "description": "Model calls by day, model and effort; only the combinations that occur. Columns: day, model, effort, calls, pricedCalls, usd, inputTokens, cacheReadTokens, cacheWriteTokens, outputTokens."
        },
        "verification": {
          "$ref": "#/$defs/table",
          "description": "One row per completed job: day (of finishedAt in the timezone), status (index into ['passed', 'failed'], the process outcome only), wallSeconds (null when not a valid observation)."
        },
        "measures": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "value", "unit", "scope", "coverage"],
            "additionalProperties": false,
            "properties": {
              "id": { "$ref": "#/$defs/metricId" },
              "value": { "type": ["number", "null"] },
              "unit": { "enum": ["usd", "calls", "ratio", "jobs", "seconds", "changes", "examples"] },
              "scope": { "enum": ["all-time", "snapshot"] },
              "numerator": { "type": ["number", "null"] },
              "denominator": { "type": ["number", "null"] },
              "coverage": { "$ref": "#/$defs/coverage" }
            }
          }
        },
        "stocks": {
          "type": "object",
          "description": "Counts at the source revision: not activity over a period.",
          "required": ["changes", "examples"],
          "additionalProperties": false,
          "properties": {
            "changes": {
              "type": "object",
              "required": ["total", "housekeeping"],
              "additionalProperties": false,
              "properties": {
                "total": { "type": "integer", "minimum": 0 },
                "housekeeping": { "type": "integer", "minimum": 0 }
              }
            },
            "examples": {
              "type": "object",
              "required": ["total", "origin", "verdict", "vacuous", "freshness"],
              "additionalProperties": false,
              "properties": {
                "total": { "type": "integer", "minimum": 0 },
                "origin": { "type": "object", "additionalProperties": { "type": "integer" } },
                "verdict": { "type": "object", "additionalProperties": { "type": "integer" } },
                "vacuous": { "type": "integer", "minimum": 0 },
                "freshness": { "type": "object", "additionalProperties": { "type": "integer" } }
              }
            }
          }
        },
        "breakdowns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "metricId", "dimension", "scope", "rows", "coverage"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "metricId": { "$ref": "#/$defs/metricId" },
              "dimension": { "enum": ["model", "effort", "area", "exampleSystem", "exampleTechnique", "exampleOrigin", "verdict"] },
              "scope": { "enum": ["all-time", "snapshot"] },
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["key", "label", "value"],
                  "additionalProperties": false,
                  "properties": {
                    "key": { "type": "string" },
                    "label": { "type": "string" },
                    "value": { "type": ["number", "null"] },
                    "share": { "type": ["number", "null"] }
                  }
                }
              },
              "coverage": { "$ref": "#/$defs/coverage" }
            }
          }
        },
        "insights": {
          "type": "array",
          "description": "Calculated observations: descriptive, reproducible from the data, with no causal claim and no model ranked above another.",
          "items": {
            "type": "object",
            "required": ["id", "metricId", "text", "value", "scope", "coverage", "evidence"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "metricId": { "$ref": "#/$defs/metricId" },
              "text": { "type": "string" },
              "value": { "type": ["number", "null"] },
              "scope": { "enum": ["all-time", "snapshot"] },
              "coverage": { "$ref": "#/$defs/coverage" },
              "evidence": {
                "type": "object",
                "required": ["collection"],
                "additionalProperties": false,
                "properties": {
                  "collection": { "enum": ["overview", "sessions", "changes", "verification", "examples"] },
                  "breakdown": { "type": ["string", "null"] }
                }
              }
            }
          }
        }
      }
    },

    "sessions": {
      "type": "object",
      "required": ["schema", "snapshotId", "records"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "software-factory-sessions/v1" },
        "snapshotId": { "$ref": "#/$defs/snapshotId" },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "status", "started", "ended", "models", "calls", "usd", "cacheReuse", "changes", "hasMetrics"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "title": { "type": ["string", "null"] },
              "status": { "type": ["string", "null"] },
              "started": { "type": ["string", "null"] },
              "ended": { "type": ["string", "null"] },
              "models": { "type": "array", "items": { "type": "string" } },
              "calls": { "type": ["integer", "null"] },
              "usd": { "type": ["number", "null"] },
              "cacheReuse": { "type": ["number", "null"] },
              "changes": { "type": "integer", "minimum": 0 },
              "hasMetrics": { "type": "boolean" },
              "summaryUrl": { "type": ["string", "null"] }
            }
          }
        }
      }
    },

    "changes": {
      "type": "object",
      "required": ["schema", "snapshotId", "records"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "software-factory-changes/v1" },
        "snapshotId": { "$ref": "#/$defs/snapshotId" },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["changeId", "summary", "sessions", "housekeeping", "area"],
            "additionalProperties": false,
            "properties": {
              "changeId": { "type": "string", "pattern": "^[k-z]{32}$" },
              "summary": { "type": "string" },
              "sessions": { "type": "array", "items": { "type": "string" } },
              "housekeeping": { "type": "boolean" },
              "area": { "type": "string" }
            }
          }
        }
      }
    },

    "verification": {
      "type": "object",
      "required": ["schema", "snapshotId", "records"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "software-factory-verification/v1" },
        "snapshotId": { "$ref": "#/$defs/snapshotId" },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "process", "signals", "expected", "attention", "finishedAt", "wallSeconds", "peakMemoryBytes", "capabilities", "sourceCommit", "submittingSession", "area"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "process": { "enum": ["passed", "failed"], "description": "Whether the job ran as its steps expected; not whether a property holds." },
              "signals": {
                "type": "array",
                "description": "Semantic outcomes the job reported, such as example:as-expected or jvmcontract:fails, with their counts.",
                "items": {
                  "type": "object",
                  "required": ["name", "count"],
                  "additionalProperties": false,
                  "properties": { "name": { "type": "string" }, "count": { "type": "integer", "minimum": 1 } }
                }
              },
              "expected": { "type": ["string", "null"], "description": "The job's own statement of its expected outcome." },
              "attention": { "type": "integer", "minimum": 0, "description": "Attention entries recorded at the time: history, not open blockers." },
              "finishedAt": { "$ref": "#/$defs/instant" },
              "wallSeconds": { "type": ["number", "null"] },
              "peakMemoryBytes": { "type": ["integer", "null"] },
              "capabilities": { "type": "array", "items": { "type": "string" } },
              "sourceCommit": { "type": ["string", "null"] },
              "submittingSession": { "type": ["string", "null"] },
              "area": { "type": "string" }
            }
          }
        }
      }
    },

    "examples": {
      "type": "object",
      "required": ["schema", "snapshotId", "records"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "software-factory-examples/v1" },
        "snapshotId": { "$ref": "#/$defs/snapshotId" },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "origin", "system", "verdict", "verdictLabel", "vacuous", "freshness", "tags"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "origin": { "enum": ["constructed", "real-world"] },
              "system": { "type": ["string", "null"] },
              "verdict": { "type": ["string", "null"] },
              "verdictLabel": { "type": ["string", "null"] },
              "vacuous": { "type": ["boolean", "null"] },
              "freshness": { "type": ["string", "null"], "description": "The example's snapshot field: current, unknown, or null when absent." },
              "tags": {
                "type": "object",
                "required": ["domain", "defect", "technique"],
                "additionalProperties": false,
                "properties": {
                  "domain": { "type": "array", "items": { "type": "string" } },
                  "defect": { "type": "array", "items": { "type": "string" } },
                  "technique": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },

    "postSummary": {
      "type": "object",
      "description": "A published post as the Software Factory pages show it, made by editorial.mjs from the already draft-filtered post collection.",
      "required": ["slug", "url", "title", "description", "author", "date", "cover", "collection", "featured", "evidence"],
      "additionalProperties": false,
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "url": { "type": "string", "pattern": "^/posts/[a-z0-9-]+/$" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "author": { "type": ["string", "null"], "description": "From the post's own author field; null when the post does not say." },
        "date": { "$ref": "#/$defs/localDate" },
        "cover": {
          "type": ["object", "null"],
          "required": ["url", "width", "height"],
          "additionalProperties": false,
          "properties": { "url": { "type": "string" }, "width": { "type": "integer" }, "height": { "type": "integer" } }
        },
        "collection": { "type": ["string", "null"] },
        "featured": { "type": "boolean" },
        "evidence": {
          "type": ["object", "null"],
          "required": ["url"],
          "additionalProperties": false,
          "properties": { "url": { "type": "string" } }
        }
      }
    },

    "evidence": {
      "type": "object",
      "description": "A post's evidence.json: the frozen data an analysis used. A complete manifest has every field non-null (editorial.mjs checks); a draft may be incomplete, never invented.",
      "required": ["schema", "status", "source", "snapshotId", "metricDefinitionsVersion", "pricingAsOf", "interval", "cohort", "models", "exclusions", "coverage", "configuration", "files"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "software-factory-evidence/v1" },
        "status": { "enum": ["complete", "incomplete"] },
        "source": {
          "type": ["object", "null"],
          "required": ["repository", "sha"],
          "additionalProperties": false,
          "properties": { "repository": { "type": "string" }, "sha": { "$ref": "#/$defs/sha" } }
        },
        "snapshotId": { "type": ["string", "null"], "pattern": "^sf1-[0-9a-f]{16}$" },
        "metricDefinitionsVersion": { "type": ["string", "null"] },
        "pricingAsOf": { "type": ["string", "null"] },
        "interval": {
          "type": ["object", "null"],
          "required": ["from", "to", "timezone"],
          "additionalProperties": false,
          "properties": {
            "from": { "$ref": "#/$defs/instant" },
            "to": { "$ref": "#/$defs/instant" },
            "timezone": { "type": "string" }
          }
        },
        "cohort": {
          "type": ["object", "null"],
          "required": ["description", "records"],
          "additionalProperties": false,
          "properties": {
            "description": { "type": "string" },
            "records": { "type": "array", "items": { "type": "string" } }
          }
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["raw", "alias"],
            "additionalProperties": false,
            "properties": { "raw": { "type": "string" }, "alias": { "type": ["string", "null"] } }
          }
        },
        "exclusions": { "type": "array", "items": { "type": "string" } },
        "coverage": { "type": ["string", "null"] },
        "configuration": { "type": ["object", "null"] },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "additionalProperties": false,
            "properties": { "path": { "type": "string" }, "sha256": { "$ref": "#/$defs/sha256" } }
          }
        }
      }
    },

    "runtime": {
      "type": "object",
      "description": "An observation from a producer on the factory machine (not built yet). Past expiresAt it is stale: shown as unavailable, never as zero active work.",
      "required": ["schema", "producer", "runId", "observedAt", "expiresAt", "sourceRevision", "states", "counters", "completeness"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "software-factory-runtime/v1" },
        "producer": {
          "type": "object",
          "required": ["id", "version"],
          "additionalProperties": false,
          "properties": { "id": { "type": "string" }, "version": { "type": "string" } }
        },
        "runId": { "type": "string" },
        "observedAt": { "$ref": "#/$defs/instant" },
        "expiresAt": { "$ref": "#/$defs/instant" },
        "sourceRevision": { "type": ["string", "null"] },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["subject", "kind", "state", "since"],
            "additionalProperties": false,
            "properties": {
              "subject": { "type": "string" },
              "kind": { "enum": ["loop", "session", "queue"] },
              "state": { "enum": ["active", "idle", "waiting", "stopped", "unknown"] },
              "since": { "type": ["string", "null"] }
            }
          }
        },
        "counters": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "completeness": {
          "type": "object",
          "required": ["complete", "note"],
          "additionalProperties": false,
          "properties": { "complete": { "type": "boolean" }, "note": { "type": ["string", "null"] } }
        }
      }
    }
  }
}
