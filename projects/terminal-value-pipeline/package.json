{
  "name": "terminal-value-pipeline",
  "version": "1.0.0",
  "description": "Feb 2026 experiment: an LLM pipeline that generates client-specific web components from CRM context.",
  "type": "module",
  "scripts": {
    "start": "vite build && vite preview",
    "gemini": "node apps/gemini-batch/index.js",
    "test": "node pipeline/functionalTests/runTests.js",
    "update-mocks": "node pipeline/functionalTests/updateFunctionalTestData.js",
    "build": "vite build",
    "package-code": "node packageCodeForLlm.js",
    "format": "prettier --write \"**/*.{js,json,md,html,css}\""
  },
  "engines": {
    "node": "24.13.1"
  },
  "author": "Filip Stankovic",
  "license": "MIT",
  "devDependencies": {
    "prettier": "2.8.8",
    "together-ai": "0.37.0",
    "vite": "7.3.1",
    "vite-plugin-static-copy": "3.2.0",
    "wrangler": "4.65.0"
  },
  "dependencies": {
    "@google/genai": "1.39.0",
    "body-parser": "2.2.2",
    "cors": "2.8.6",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "morgan": "1.10.1",
    "uuid": "13.0.0"
  },
  "private": true
}
